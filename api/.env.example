# API Configuration
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_textbook

# Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAG Service
RAG_SERVICE_URL=http://localhost:3001

# OpenAI (optional - if using OpenAI directly)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload
MAX_UPLOAD_SIZE=10485760

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# External Services
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Monitoring (optional)
SENTRY_DSN=